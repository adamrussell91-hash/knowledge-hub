SITE_ORIGIN=https://knowledge-hub.adam-russell.com
# Browser API origin is baked at Pages build time (see .github/workflows/pages.yml).
# VITE_API_BASE=https://knowledge-api.adam-russell.com/api
TEACHING_HUB_ORIGIN=http://localhost:5174
ALCHEMIST_SHARED_SECRET=
ANTHROPIC_API_KEY=
EMBEDDINGS_API_KEY=
# Optional: build vector index with `npm run build-index` once EMBEDDINGS_API_KEY is set.
# Without it, Lesson Alchemist falls back to lexical retrieval over the manifest.
GITHUB_DATA_REPO=adamrussell91-hash/knowledge-hub-data
GITHUB_DATA_REPO_TOKEN=
R2_BUCKET=knowledge-hub-archive
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
