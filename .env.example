KNOWLEDGE_HUB_PASSPHRASE_HASH=
SESSION_SECRET=
# Production Pages origin (CORS). Local Vite does not need this.
SITE_ORIGIN=https://knowledge-hub.adam-russell.com
# Browser API origin is baked at Pages build time (see .github/workflows/pages.yml).
# VITE_API_BASE=https://knowledge-api.adam-russell.com/api
TEACHING_HUB_ORIGIN=http://localhost:5174
ALCHEMIST_SHARED_SECRET=
RESEARCH_KERNEL_SHARED_SECRET=
# Worker origin the coach function calls server-side. The browser never sees this secret.
RESEARCH_KERNEL_URL=https://knowledge-hub-research.adamrussell91.workers.dev
ANTHROPIC_API_KEY=
# OpenAI API key used only for embeddings (text-embedding-3-small), not chat.
EMBEDDINGS_API_KEY=
# Optional: build vector index with `npm run build-index` once EMBEDDINGS_API_KEY is set.
# Without it, Lesson Alchemist falls back to lexical retrieval over the manifest.
GITHUB_DATA_REPO=adamrussell91-hash/knowledge-hub-data
GITHUB_DATA_REPO_TOKEN=
# Wiki Run now / nightly curator uses the Netlify background function (same GitHub + Anthropic + R2 env as page save).
# Optional: PAT with contents:read/write on the data repo if you want to run `.github/workflows/curator.yml` manually.
GITHUB_CODE_REPO=adamrussell91-hash/knowledge-hub
R2_BUCKET=knowledge-hub-archive
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
