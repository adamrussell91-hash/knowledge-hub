{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "knowledge-hub-research",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"]
    }
  ],
  "routes": [
    {
      "pattern": "knowledge-tidy.adam-russell.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "TEACHING_HUB_ORIGIN": "https://teaching-hub.adam-russell.com",
    "KNOWLEDGE_HUB_ORIGIN": "https://knowledge-hub.adam-russell.com",
    "GITHUB_DATA_REPO": "adamrussell91-hash/knowledge-hub-data"
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "knowledge-hub-archive"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESEARCH_SESSION",
        "class_name": "ResearchSession"
      },
      {
        "name": "PODCAST_SESSION",
        "class_name": "PodcastSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ResearchSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PodcastSession"]
    }
  ]
}
